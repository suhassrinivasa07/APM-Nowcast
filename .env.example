# APM-Nowcast Environment Configuration

# Backend Service
APP_NAME="APM-Nowcast API"
APP_ENV="development"
DEBUG=True
API_HOST="0.0.0.0"
API_PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL - for subsequent phases)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="apm_nowcast"

# Hardware / Acceleration
DEVICE="cuda"  # "cuda" or "cpu"
GPU_MEMORY_FRACTION=0.8

# Frontend Service
VITE_API_BASE_URL="http://localhost:8000"

# ---------------------------------------------------------------------------
# Module 2 — Data Ingestion Credentials (all optional)
# ---------------------------------------------------------------------------

# Copernicus CDS (ERA5 reanalysis data)
# Registration: https://cds.climate.copernicus.eu/user/register
# API key format: <UID>:<API_KEY>  (also readable from ~/.cdsapirc)
CDSAPI_URL="https://cds.climate.copernicus.eu/api/v2"
CDSAPI_KEY=""

# MOSDAC Portal (INSAT-3D/3DR/3DS satellite imagery)
# Registration: https://www.mosdac.gov.in/
MOSDAC_USER=""
MOSDAC_PASSWORD=""

# NASA Earthdata (GPM IMERG precipitation)
# Token: https://urs.earthdata.nasa.gov/profile
EARTHDATA_TOKEN=""

# IMD DWR / NRSC Lightning — no automated API available.
# Place locally-downloaded files in:
#   data/raw/radar/     → DWR NetCDF/HDF5 exports
#   data/raw/lightning/ → NRSC Lightning CSV / NetCDF

